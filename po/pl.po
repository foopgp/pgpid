msgid "Error: Only a passport zone is read, and this does not begin with 'P'."
msgstr "Error: Czytana jest tylko strefa paszportu, a ta nie zaczyna się od „P”."

#: ../src/genu4.c:205
#, c-format
msgid "%s: The zone is %zu characters, not 88."
msgstr "%s: Strefa ma %zu znaków, nie 88."

#: ../src/genu4.c:218
#, c-format
