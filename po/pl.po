msgstr "Error: „%s” nie jest znanym nam trzyliterowym kodem kraju."

#: ../src/genu4.c:301
msgid "Error: Where is the machine readable zone?"
msgstr "Error: Gdzie jest strefa do odczytu maszynowego?"

