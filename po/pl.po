#: ../src/trustdb.c:40
#, c-format
msgid ""
"Usage: %s trustdb local|export|import [OPTIONS]... [FINGERPRINT|OWNERTRUSTS.GPG]...\n"
"\n"
"Read and move the credibility you grant others to certify.\n"
"\n"
"  local    What this machine says about the given certificates, or about\n"
"           every one of them when none is named.\n"
"  export   The same, signed, for others to replay. Writes to stdout.\n"
"  import   Apply what others signed, fetching the keys it names. Order\n"
"           is part of what it means: a signer must already be valid when\n"
"           its turn comes, and each file is weighed against what the\n"
"           one before it decided.\n"
"\n"
"OPTIONS:\n"
"  -r, --replace-to VALUE      local: set it instead of printing it — needs\n"
"                              at least one fingerprint\n"
"      --long                  local: also the identifier and main address\n"
"      --export-file FILE      export: write there instead of stdout\n"
"  -u, --use-privkey NAME|KEYID  export: sign with this key\n"
"      --export-all            export: include ultimate and unknown too\n"
"      --armor                 export: ASCII rather than binary, to commit it\n"
"      --import-fetch-all      import: fetch or refresh every key it names,\n"
"                              not only the ones missing here\n"
"  -K, --keyservers SERVERS    import: ask these, space separated — empty\n"
"                              for none\n"
"      --check                 recompute without asking about the rest\n"
"      --update                recompute, asking about the rest\n"
"  -q, --quiet                 Only errors and warnings\n"
"  -h, --help                  Print this help and exit\n"
"  -V, --version               Print the version and exit\n"
msgstr ""
"Usage: %s trustdb local|export|import [OPTIONS]... [ODCISK|OWNERTRUSTS.GPG]...\n"
"\n"
"Czyta wiarygodność innych i przenosi ją dalej.\n"
"\n"
"  local    Co ta maszyna mówi o podanych certyfikatach, albo o każdym z\n"
"           nich, gdy nie podano żadnego.\n"
"  export   To samo, podpisane, by inni mogli to odtworzyć. Pisze na stdout.\n"
"  import   Zastosować to, co podpisali inni, pobierając klucze, które\n"
"           wymienia. Kolejność należy do znaczenia: podpisujący musi być już\n"
"           ważny, gdy przyjdzie jego kolej, a każdy plik waży się wobec\n"
"           tego, co orzekł poprzedni.\n"
"\n"
"OPTIONS:\n"
"  -r, --replace-to WARTOŚĆ    local: ustawić zamiast wypisywać — wymaga co\n"
"                              najmniej jednego odcisku\n"
"      --long                  local: także identyfikator i główny adres\n"
"      --export-file PLIK      export: pisać tam zamiast na stdout\n"
"  -u, --use-privkey NAZWA|KEYID  export: podpisać tym kluczem\n"
"      --export-all            export: objąć także ultimate i unknown\n"
"      --armor                 export: ASCII zamiast binarnego, by go wersjonować\n"
"      --import-fetch-all      import: pobrać lub odświeżyć wszystkie jego klucze,\n"
"                              nie tylko te, których tu brak\n"
"  -K, --keyservers SERWERY    import: pytać tych, rozdzielonych spacjami\n"
"                              — puste, by nikogo nie pytać\n"
"      --check                 Przeliczyć bez pytania o pozostałe\n"
"      --update                Przeliczyć, pytając o pozostałe\n"
"  -q, --quiet                 Tylko błędy i ostrzeżenia\n"
"  -h, --help                  Wypisać tę pomoc i zakończyć\n"
"  -V, --version               Wypisać wersję i zakończyć\n"

#: ../src/trustdb.c:313
msgid "Error: Cannot make a temporary file."
msgstr "Error: Nie można utworzyć pliku tymczasowego."

#: ../src/trustdb.c:332
#, c-format
msgid "Error: Cannot read or verify %s (missing, not signed, or bad signature?)."
msgstr "Error: Nie można odczytać ani zweryfikować %s (brak, niepodpisany, czy zły podpis?)."

#: ../src/trustdb.c:354
#, c-format
msgid "Error: %s carries no verifiable signature (signer key missing?)."
msgstr "Error: %s nie nosi weryfikowalnego podpisu (brak klucza podpisującego?)."

#: ../src/trustdb.c:366
#, c-format
msgid "Warning: %s is signed in the future (%s) — is the local clock right?"
msgstr "Warning: %s jest podpisany w przyszłości (%s) — czy zegar lokalny chodzi dobrze?"

#: ../src/trustdb.c:374
#, c-format
msgid "Warning: %s carries a delegation older than a year (%s)."
msgstr "Warning: %s nosi delegację starszą niż rok (%s)."

#: ../src/trustdb.c:388 ../src/trustdb.c:394
#, c-format
msgid "Error: %s is not a valid ownertrust file."
msgstr "Error: %s nie jest poprawnym plikiem ownertrust."

#: ../src/trustdb.c:541
#, c-format
msgid "Info: %s: %zu line(s) about your own anchors, left alone."
msgstr "Info: %s: %zu wiersz(y) o twoich własnych kotwicach, pozostawionych bez zmian."

#: ../src/trustdb.c:544
#, c-format
msgid "Info: %s: %zu key(s) you have ruled never on, left alone."
msgstr "Info: %s: %zu klucz(y), co do których orzekłeś never, pozostawione bez zmian."

#: ../src/trustdb.c:547
#, c-format
msgid "Info: %s: %zu key(s) it credits less than you already do, left alone."
msgstr "Info: %s: %zu klucz(y), którym daje mniej niż ty już dajesz, pozostawione bez zmian."

#: ../src/trustdb.c:550
#, c-format
msgid "Info: %s: %zu line(s) beyond full, brought back to it."
msgstr "Info: %s: %zu wiersz(y) powyżej full, sprowadzonych z powrotem do full."

#: ../src/trustdb.c:553
#, c-format
msgid "Info: %s: %zu key(s) it would have you credit with nothing."
msgstr "Info: %s: %zu klucz(y), którym każe ci odmówić wszelkiej wiarygodności."

#: ../src/trustdb.c:578
msgid "Info: credibility changes:"
msgstr "Info: zmiany wiarygodności:"

#: ../src/trustdb.c:581
#, c-format
msgid "  - %s"
msgstr "  - %s"

#: ../src/trustdb.c:584
#, c-format
msgid "  + %s"
msgstr "  + %s"

#: ../src/trustdb.c:613
msgid "listing the certificates"
msgstr "wypisywanie certyfikatów"

#: ../src/trustdb.c:678
msgid "Error: A fingerprint is required to set a credibility."
msgstr "Error: Do ustawienia wiarygodności potrzebny jest odcisk."

#: ../src/trustdb.c:684
msgid "Notice: One of undefined, never, marginal, full, ultimate."
msgstr "Notice: Jeden z undefined, never, marginal, full, ultimate."

#: ../src/trustdb.c:691
msgid "Error: 'unknown' cannot be set; it is what a certificate"
msgstr "Error: „unknown” nie da się ustawić; tak czyta się certyfikat,"

#: ../src/trustdb.c:692
msgid "Notice: no one has ruled on already reads as."
msgstr "Notice: co do którego nikt jeszcze nie rozstrzygnął."

#: ../src/trustdb.c:725
msgid "setting the credibility"
msgstr "ustawianie wiarygodności"

#: ../src/trustdb.c:770
#, c-format
msgid "Error: '%s' wants a path."
msgstr "Error: „%s” oczekuje ścieżki."

#: ../src/trustdb.c:796
msgid "Error: 'export' takes no argument; the path goes to --export-file."
msgstr "Error: „export” nie bierze argumentu; ścieżka idzie do --export-file."

#: ../src/trustdb.c:828
msgid "Error: Nothing to export: no decision worth signing."
msgstr "Error: Nie ma czego eksportować: żadnej decyzji wartej podpisu."

#: ../src/trustdb.c:854
msgid "Error: gpg would not sign the export."
msgstr "Error: gpg nie chciał podpisać eksportu."

#: ../src/trustdb.c:857
#, c-format
msgid "Notice: %zu delegation(s) signed. Publish it beside the tree it explains, so that anyone can replay it."
msgstr "Notice: Podpisano %zu delegacji. Opublikuj ją obok drzewa, które tłumaczy, by każdy mógł ją odtworzyć."

#: ../src/trustdb.c:875
msgid "Error: Cannot read what this machine already says."
msgstr "Error: Nie da się odczytać tego, co ta maszyna już mówi."

#: ../src/trustdb.c:886
msgid "Error: No key here is ultimate, so there is no anchor to extend from."
msgstr "Error: Żaden klucz nie jest tu ultimate, nie ma więc kotwicy do rozciągnięcia."

#: ../src/trustdb.c:888
#, c-format
msgid "Notice: Mark your own certificate ultimate first: %s trustdb local --replace-to ultimate FINGERPRINT"
msgstr "Notice: Najpierw oznacz własny certyfikat jako ultimate: %s trustdb local --replace-to ultimate ODCISK"

#: ../src/trustdb.c:939
msgid "Info: The delegations are already applied — credibility left unchanged."
msgstr "Info: Delegacje są już zastosowane — wiarygodność pozostaje bez zmian."

#: ../src/trustdb.c:960
#, c-format
msgid "Notice: Current credibility backed up in %s."
msgstr "Notice: Obecną wiarygodność zabezpieczono w %s."

#: ../src/trustdb.c:962
#, c-format
msgid "Warning: Cannot write the backup %s — going ahead anyway would leave no way back. Stopping."
msgstr "Warning: Nie można zapisać kopii %s — pójście dalej mimo to nie zostawiłoby drogi powrotnej. Zatrzymanie."

#: ../src/trustdb.c:970
#, c-format
msgid "Error: Delegation chain broken: the signer of %s is not (yet) valid."
msgstr "Error: Łańcuch delegacji przerwany: podpisujący %s nie jest (jeszcze) ważny."

#: ../src/trustdb.c:977
#, c-format
msgid "Error: gpg would not import the delegation from %s."
msgstr "Error: gpg odmówił zaimportowania delegacji z %s."

#: ../src/trustdb.c:991
#, c-format
msgid "Notice: To restore the previous credibility: gpg --import-ownertrust %s"
msgstr "Notice: Aby przywrócić poprzednią wiarygodność: gpg --import-ownertrust %s"

#: ../src/trustdb.c:1045
msgid "Error: Too many files at once."
msgstr "Error: Za dużo plików naraz."

#: ../src/trustdb.c:1073
msgid "Error: One of local, export or import is required."
msgstr "Error: Potrzebne jest jedno z local, export lub import."

#: ../src/trustdb.c:1097
#, c-format
msgid "Error: '%s' is not one of local, export or import."
msgstr "Error: „%s” to ani local, ani export, ani import."

#: ../src/uidedit.c:69
msgid "Error: Revoking a User ID is irreversible — OpenPGP keeps it"
msgstr "Error: Unieważnienie User ID jest nieodwracalne — OpenPGP zachowuje je"

#: ../src/uidedit.c:70
msgid "on the certificate forever, marked revoked, and an identical one"
msgstr "na certyfikacie na zawsze, oznaczone jako unieważnione, a identycznego"

#: ../src/uidedit.c:71
msgid "can never be added again. Pass --yes if that is what you want:"
msgstr "nigdy już nie da się dodać. Podaj --yes, jeśli o to ci chodzi:"

#: ../src/uidedit.c:72
#, c-format
msgid "  %s"
msgstr "  %s"

#: ../src/uidedit.c:75
#, c-format
msgid "Notice: Revoking %s inside certificate %s…"
msgstr "Notice: Unieważnianie %s w certyfikacie %s…"

#: ../src/uidedit.c:78
#, c-format
msgid "Error: gpg would not revoke %s."
msgstr "Error: gpg odmówił unieważnienia %s."

#: ../src/uidedit.c:115
#, c-format
msgid "Warning: No address left on certificate %s to carry the primary User ID flag."
msgstr "Warning: Na certyfikacie %s nie został żaden adres, który mógłby nieść znacznik głównego User ID."

#: ../src/uidedit.c:119
#, c-format
msgid "Notice: Main identity is no longer an address: moving the primary User ID flag to %s."
msgstr "Notice: Główna tożsamość nie jest już adresem: znacznik głównego User ID przechodzi na %s."

#: ../src/uidedit.c:123
msgid "Error: gpg would not move the primary User ID flag."
msgstr "Error: gpg odmówił przeniesienia znacznika głównego User ID."

#: ../src/uidedit.c:173
#, c-format
msgid "Notice: Minting the identity uid %s…"
msgstr "Notice: Bicie uid tożsamości %s…"

#: ../src/uidedit.c:176
#, c-format
msgid "Error: gpg would not add %s."
msgstr "Error: gpg odmówił dodania %s."

#: ../src/uidedit.c:195
#, c-format
msgid "Warning: gpg would not add %s."
msgstr "Warning: gpg odmówił dodania %s."

#, c-format
#~ msgid "Warning: More than %d keys have a credibility here; the rest are weighed as though undecided."
#~ msgstr "Warning: Ponad %d kluczy ma tu wiarygodność; resztę waży się jako nierozstrzygniętą."

#, c-format
#~ msgid "Error: No complete surname and given names in '%s'."
#~ msgstr "Error: Brak pełnego nazwiska i imion w „%s”."

#, c-format
#~ msgid "Error: '%s' is not a date this can read."
#~ msgstr "Error: „%s” nie jest datą czytelną tutaj."

#~ msgid "Error: With --from-passport-mrz the name and the country come from the zone."
#~ msgstr "Error: Przy --from-passport-mrz nazwisko i kraj pochodzą ze strefy."

#, c-format
#~ msgid ""
#~ "Usage: %s mrz_to_u4 [OPTIONS]... MRZ...\n"
#~ "\n"
#~ "Print the entity identifier the machine readable zone of a passport\n"
#~ "gives. The zone is 88 characters over two lines; spaces and newlines\n"
#~ "are ignored, so it can be pasted as it was read.\n"
#~ "\n"
#~ "OPTIONS:\n"
#~ "  -d, --birth-date YYYY-MM-DD  Date of birth, for anyone the two digits cannot place\n"
#~ "  -u, --uncheck                Report a failing check digit rather than refusing\n"
#~ "  -h, --help                   Print this help and exit\n"
#~ "  -V, --version                Print the version and exit\n"
#~ "\n"
#~ "Roughly one passport in five gives the wrong identifier: a surname\n"
#~ "truncated to fit, a name changed since birth, another transliteration,\n"
#~ "or a year of birth two digits cannot place. It has to be checked.\n"
#~ msgstr ""
#~ "Usage: %s mrz_to_u4 [OPTIONS]... MRZ...\n"
#~ "\n"
#~ "Wypisuje identyfikator jednostki, który daje strefa do odczytu\n"
#~ "maszynowego paszportu. Strefa ma 88 znaków w dwóch wierszach; spacje\n"
#~ "i końce wierszy są pomijane, można ją więc wkleić tak, jak odczytano.\n"
#~ "\n"
#~ "OPTIONS:\n"
#~ "  -d, --birth-date RRRR-MM-DD  Data urodzenia, gdy dwie cyfry nie wystarczą\n"
#~ "  -u, --uncheck                Zgłosić błędną cyfrę kontrolną, bez odmowy\n"
#~ "  -h, --help                   Wypisać tę pomoc i zakończyć\n"
#~ "  -V, --version                Wypisać wersję i zakończyć\n"
#~ "\n"
#~ "Mniej więcej co piąty paszport daje błędny identyfikator: nazwisko\n"
#~ "skrócone, by się zmieściło, imię zmienione od urodzenia, inna\n"
#~ "transliteracja, albo rok, którego dwie cyfry nie umieszczają. Trzeba to\n"
#~ "sprawdzić.\n"

#, c-format
#~ msgid "Error: '%s' wants a date."
#~ msgstr "Error: „%s” oczekuje daty."

#~ msgid "setting the ownertrust"
#~ msgstr "ustawianie ownertrust"

#, c-format
#~ msgid ""
#~ "Usage: %s ownertrust [OPTIONS]... FINGERPRINT\n"
#~ "\n"
#~ "Print how far that certificate is trusted to certify others: one of\n"
#~ "unknown, never, marginal, full, ultimate.\n"
#~ "\n"
#~ "'undefined' can be set and reads back as 'unknown': the engine does not\n"
#~ "keep them apart, and neither does anyone who has had to explain the\n"
#~ "difference. One rung, two spellings.\n"
#~ "\n"
#~ "OPTIONS:\n"
#~ "  -r, --replace-to VALUE      Set it to VALUE instead of printing it\n"
#~ "  -h, --help                  Print this help and exit\n"
#~ msgstr ""
#~ "Usage: %s ownertrust [OPTIONS]... ODCISK\n"
#~ "\n"
#~ "Wypisuje, jak dalece ufa się temu certyfikatowi w poświadczaniu innych:\n"
#~ "jedno z unknown, never, marginal, full, ultimate.\n"
#~ "\n"
#~ "„undefined” da się ustawić i odczytuje się jako „unknown”: silnik ich nie\n"
#~ "rozróżnia, i nikt, kto musiał kiedyś tłumaczyć różnicę, też nie. Jeden\n"
#~ "szczebel, dwie pisownie.\n"
#~ "\n"
#~ "OPTIONS:\n"
#~ "  -r, --replace-to WARTOŚĆ    Ustawić na WARTOŚĆ zamiast wypisywać\n"
#~ "  -h, --help                  Wypisać tę pomoc i zakończyć\n"

#, c-format
#~ msgid ""
#~ "Usage: %s update_trustdb [OPTIONS]... [OWNERTRUST.GPG]...\n"
#~ "\n"
#~ "Recompute GnuPG's trust database, after applying the delegations the\n"
#~ "given files carry.\n"
#~ "\n"
#~ "Every file must be a signed OpenPGP message, and its signer must already\n"
#~ "be valid when its turn comes — which is why the order of the files is\n"
#~ "part of what they mean. Whatever they say about your own keys is\n"
#~ "ignored: somebody may extend trust to others, not redefine yours.\n"
#~ "\n"
#~ "OPTIONS:\n"
#~ "      --batch                 Recompute without asking about the remaining keys\n"
#~ "  -q, --quiet                 Only errors and warnings\n"
#~ "  -h, --help                  Print this help and exit\n"
#~ "  -V, --version               Print the version and exit\n"
#~ msgstr ""
#~ "Usage: %s update_trustdb [OPTIONS]... [OWNERTRUST.GPG]...\n"
#~ "\n"
#~ "Przelicza bazę zaufania GnuPG po zastosowaniu delegacji, które niosą\n"
#~ "podane pliki.\n"
#~ "\n"
#~ "Każdy plik musi być podpisaną wiadomością OpenPGP, a jego podpisujący\n"
#~ "musi być już ważny, gdy przyjdzie jego kolej — dlatego kolejność plików\n"
#~ "należy do tego, co znaczą. To, co mówią o twoich własnych kluczach, jest\n"
#~ "pomijane: można rozciągnąć zaufanie na innych, nie przedefiniować twojego.\n"
#~ "\n"
#~ "OPTIONS:\n"
#~ "      --batch                 Przeliczyć bez pytania o pozostałe klucze\n"
#~ "  -q, --quiet                 Tylko błędy i ostrzeżenia\n"
#~ "  -h, --help                  Wypisać tę pomoc i zakończyć\n"
#~ "  -V, --version               Wypisać wersję i zakończyć\n"
