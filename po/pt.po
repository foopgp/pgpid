#: ../src/push.c:30
#, c-format
msgid ""
"Usage: %s push [OPTIONS]... FINGERPRINT...\n"
"\n"
"Send certificates to the keyservers as they stand, changing nothing.\n"
"Fingerprints only: what is published cannot be recalled.\n"
"\n"
"OPTIONS:\n"
"  -K, --keyservers SERVERS    Send to these, space separated\n"
"                              Empty for none. Default: %s\n"
"  -h, --help                  Print this help and exit\n"
"  -V, --version               Print the version and exit\n"
msgstr ""
"Usage: %s push [OPTIONS]... IMPRESSÃO...\n"
"\n"
"Enviar certificados aos servidores de chaves tal como estão, sem mudar\n"
"nada. Só impressões digitais: o que é publicado não se chama de volta.\n"
"\n"
"OPTIONS:\n"
"  -K, --keyservers SERVIDORES Enviar a estes, separados por espaços\n"
"                              Vazio para nenhum. Omissão: %s\n"
"  -h, --help                  Imprimir esta ajuda e sair\n"
"  -V, --version               Imprimir a versão e sair\n"

#: ../src/push.c:80
msgid "Error: Which certificate?"
msgstr "Error: Que certificado?"

#: ../src/push.c:92
msgid "Notice: Publishing takes fingerprints, so a search never becomes a broadcast."
msgstr "Notice: Publicar exige impressões digitais, assim uma pesquisa nunca se torna difusão."

#: ../src/push.c:99
