#, c-format
#~ msgid ""
#~ "Usage: %s [OPTIONS]... ACTION [ARGS]...\n"
#~ "\n"
#~ "Read and act on OpenPGP certificates through the pgpid model: entity\n"
#~ "identifiers, validity, credibility.\n"
#~ "\n"
#~ "ACTIONS:\n"
#~ "  list                        List the certificates of the keyring\n"
#~ "  get                         Look a certificate up, refreshing it first\n"
#~ "  property                    Print a vCard property of one certificate\n"
#~ "  sigs                        List who has certified one certificate\n"
#~ "  del                         Delete certificates, by fingerprint only\n"
#~ "  avatar                      Extract the image a certificate wears\n"
#~ "  push                        Send certificates to the keyservers\n"
#~ "  gen_u4                      Print the identifier a civil status or a passport gives\n"
#~ "  gen_uid                     Print the Unix account number an identifier gives\n"
#~ "  to_vcard                    Print a certificate as a vCard\n"
#~ "  email                       Show, add or revoke the addresses a certificate carries\n"
#~ "  certify                     Vouch for somebody else\n"
#~ "  trustdb                     Read, publish and apply the credibility of others\n"
#~ "  gen_key                     Generate a key pair the PGP ID way\n"
#~ "  change_passphrase           Change what protects a secret key here\n"
#~ "  token_check                 Check what the connected security key carries\n"
#~ "  token_retries               Attempts left on the key's codes\n"
#~ "  totoken                     Move a secret key onto a security key\n"
#~ "  change_token_code           Check or change its PIN or Admin code\n"
#~ "  change_token_meta           Write what it says about its holder\n"
#~ "  print_secret                Put a secret key on paper, in fragments\n"
#~ "  scan                        Put it back together from the fragments\n"
#~ "  print_card                  Produce or print a sticker or business card\n"
#~ "\n"
#~ "OPTIONS:\n"
#~ "  -H, --homedir DIR           GnuPG home directory - Environment variable: GNUPGHOME\n"
#~ "      --output-format=FORMAT  Specify output format between {raw, info, md} - Default: 'raw'\n"
#~ "  -B, --batch                 Never ask: fail instead of prompting for what is missing\n"
#~ "  -h, --help                  Print this help and exit\n"
#~ "  -V, --version               Print the version and exit\n"
#~ "\n"
#~ "Every action takes --help of its own.\n"
#~ msgstr ""
#~ "Usage: %s [OPTIONS]... ACTION [ARGS]...\n"
#~ "\n"
#~ "Ler e agir sobre certificados OpenPGP segundo o modelo pgpid:\n"
#~ "identificadores de entidade, validade, credibilidade.\n"
#~ "\n"
#~ "ACTIONS:\n"
#~ "  list                        Listar os certificados do porta-chaves\n"
#~ "  get                         Procurar um certificado, atualizando-o antes\n"
#~ "  property                    Imprimir uma propriedade vCard de um certificado\n"
#~ "  sigs                        Listar quem certificou um certificado\n"
#~ "  del                         Apagar certificados, só por impressão digital\n"
#~ "  avatar                      Extrair a imagem que um certificado traz\n"
#~ "  push                        Enviar certificados aos servidores de chaves\n"
#~ "  gen_u4                      Imprimir o identificador de um estado civil ou passaporte\n"
#~ "  gen_uid                     Imprimir o número de conta Unix de um identificador\n"
#~ "  to_vcard                    Imprimir um certificado como vCard\n"
#~ "  email                       Mostrar, acrescentar ou revogar os endereços\n"
#~ "  certify                     Responder por outra pessoa\n"
#~ "  trustdb                     Ler, publicar e aplicar a credibilidade dada a outros\n"
#~ "  gen_key                     Gerar um par de chaves à maneira PGP ID\n"
#~ "  change_passphrase           Mudar o que protege uma chave secreta aqui\n"
#~ "  token_check                 Verificar o que a chave de segurança ligada traz\n"
#~ "  token_retries               Tentativas restantes nos códigos da chave\n"
#~ "  totoken                     Mover uma chave secreta para uma chave de segurança\n"
#~ "  change_token_code           Verificar ou mudar o seu PIN ou código Admin\n"
#~ "  change_token_meta           Escrever o que ela diz do seu portador\n"
#~ "  print_secret                Pôr uma chave secreta em papel, em fragmentos\n"
#~ "  scan                        Recompô-la a partir dos fragmentos\n"
#~ "  print_card                  Produzir ou imprimir um autocolante ou um cartão\n"
#~ "\n"
#~ "OPTIONS:\n"
#~ "  -H, --homedir DIRETÓRIO     Diretório GnuPG - Variável de ambiente: GNUPGHOME\n"
#~ "      --output-format=FORMATO Formato de saída entre {raw, info, md} - Omissão: «raw»\n"
#~ "  -B, --batch                 Nunca perguntar: falhar em vez de pedir o que falta\n"
#~ "  -h, --help                  Imprimir esta ajuda e sair\n"
#~ "  -V, --version               Imprimir a versão e sair\n"
#~ "\n"
#~ "Cada ação tem o seu próprio --help.\n"

