msgid "Error: A fingerprint is required to set a credibility."
msgstr "Error: Zum Setzen einer Glaubwürdigkeit wird ein Fingerabdruck gebraucht."

#: ../src/trustdb.c:691
msgid "Notice: One of undefined, never, marginal, full, ultimate."
msgstr "Notice: Eines von undefined, never, marginal, full, ultimate."

#: ../src/trustdb.c:698
msgid "Error: 'unknown' cannot be set; it is what a certificate"
msgstr "Error: „unknown“ lässt sich nicht setzen; so liest sich ein Zertifikat,"

#: ../src/trustdb.c:699
msgid "Notice: no one has ruled on already reads as."
msgstr "Notice: über das noch niemand entschieden hat."

#: ../src/trustdb.c:732
msgid "setting the credibility"
msgstr "Glaubwürdigkeit wird gesetzt"

#: ../src/trustdb.c:790
#, c-format
msgid "Error: '%s' wants a path."
msgstr "Error: „%s“ erwartet einen Pfad."

#: ../src/trustdb.c:816
msgid "Error: 'export' takes no argument; the path goes to --export-file."
msgstr "Error: „export“ nimmt kein Argument; der Pfad gehört zu --export-file."

#: ../src/trustdb.c:848
msgid "Error: Nothing to export: no decision worth signing."
msgstr "Error: Nichts zu exportieren: keine Entscheidung, die eine Signatur wert wäre."

#: ../src/trustdb.c:874
msgid "Error: gpg would not sign the export."
msgstr "Error: gpg wollte den Export nicht signieren."

#: ../src/trustdb.c:877
#, c-format
msgid "Notice: %zu delegation(s) signed. Publish it beside the tree it explains, so that anyone can replay it."
msgstr "Notice: %zu Delegation(en) signiert. Legen Sie sie neben den Baum, den sie erklärt, damit jeder sie nachvollziehen kann."

#: ../src/trustdb.c:895
msgid "Error: Cannot read what this machine already says."
msgstr "Error: Was diese Maschine schon sagt, lässt sich nicht lesen."

#: ../src/trustdb.c:906
msgid "Error: No key here is ultimate, so there is no anchor to extend from."
msgstr "Error: Hier ist kein Schlüssel ultimate, es gibt also keinen Anker zum Ausdehnen."

#: ../src/trustdb.c:908
#, c-format
msgid "Notice: Mark your own certificate ultimate first: %s trustdb local --replace-to ultimate FINGERPRINT"
msgstr "Notice: Markieren Sie zuerst Ihr eigenes Zertifikat als ultimate: %s trustdb local --replace-to ultimate FINGERABDRUCK"

#: ../src/trustdb.c:959
msgid "Info: The delegations are already applied — credibility left unchanged."
msgstr "Info: Die Delegationen sind bereits angewandt — die Glaubwürdigkeit bleibt unverändert."

#: ../src/trustdb.c:980
#, c-format
msgid "Notice: Current credibility backed up in %s."
msgstr "Notice: Aktuelle Glaubwürdigkeit gesichert in %s."

#: ../src/trustdb.c:982
#, c-format
msgid "Warning: Cannot write the backup %s — going ahead anyway would leave no way back. Stopping."
msgstr "Warning: Die Sicherung %s lässt sich nicht schreiben — trotzdem weiterzumachen ließe keinen Weg zurück. Abbruch."

#: ../src/trustdb.c:990
#, c-format
msgid "Error: Delegation chain broken: the signer of %s is not (yet) valid."
msgstr "Error: Delegationskette gebrochen: der Signierende von %s ist (noch) nicht gültig."

#: ../src/trustdb.c:997
#, c-format
msgid "Error: gpg would not import the delegation from %s."
msgstr "Error: gpg weigerte sich, die Delegation von %s einzulesen."

#: ../src/trustdb.c:1011
#, c-format
msgid "Notice: To restore the previous credibility: gpg --import-ownertrust %s"
msgstr "Notice: Um die vorige Glaubwürdigkeit wiederherzustellen: gpg --import-ownertrust %s"

#: ../src/trustdb.c:1065
msgid "Error: Too many files at once."
msgstr "Error: Zu viele Dateien auf einmal."

#: ../src/trustdb.c:1093
msgid "Error: One of local, export or import is required."
msgstr "Error: Eines von local, export oder import wird gebraucht."

#: ../src/trustdb.c:1117
#, c-format
msgid "Error: '%s' is not one of local, export or import."
msgstr "Error: „%s“ ist weder local noch export noch import."

#: ../src/uidedit.c:69
msgid "Error: Revoking a User ID is irreversible — OpenPGP keeps it"
msgstr "Error: Eine User-ID zu widerrufen ist unumkehrbar — OpenPGP behält sie"

#: ../src/uidedit.c:70
