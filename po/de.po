msgstr "Notice: Die Hauptidentität ist keine Adresse mehr: die primäre User-ID-Markierung wandert auf %s."

#: ../src/uidedit.c:123
msgid "Error: gpg would not move the primary User ID flag."
msgstr "Error: gpg weigerte sich, die primäre User-ID-Markierung zu verschieben."

#: ../src/uidedit.c:173
#, c-format
msgid "Notice: Minting the identity uid %s…"
msgstr "Notice: Die Identitäts-uid %s wird geprägt…"

#: ../src/uidedit.c:176
#, c-format
msgid "Error: gpg would not add %s."
msgstr "Error: gpg weigerte sich, %s hinzuzufügen."

#: ../src/uidedit.c:195
#, c-format
msgid "Warning: gpg would not add %s."
msgstr "Warning: gpg weigerte sich, %s hinzuzufügen."

