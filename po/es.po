#, c-format
msgid "Notice: About to wipe the key %s. This cannot be undone."
msgstr "Notice: a punto de borrar la llave %s. Esto no se deshace."

#: ../src/tokendel.c:134
#, c-format
msgid "Notice: %zu stub(s) will be forgotten; the certificates stay."
msgstr "Notice: se olvidarán %zu resguardo(s); los certificados se quedan."

#: ../src/tokendel.c:147
