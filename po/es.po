#, c-format
msgid "Info: %s: %zu key(s) you have ruled never on, left alone."
msgstr "Info: %s: %zu clave(s) sobre las que ha decidido never, dejadas tal cual."

#: ../src/trustdb.c:548
#, c-format
msgid "Info: %s: %zu key(s) it credits less than you already do, left alone."
msgstr "Info: %s: %zu clave(s) que acredita menos que usted ya, dejadas tal cual."

#: ../src/trustdb.c:551
#, c-format
msgid "Info: %s: %zu line(s) beyond full, brought back to it."
msgstr "Info: %s: %zu línea(s) más allá de full, devueltas a full."

#: ../src/trustdb.c:554
#, c-format
msgid "Info: %s: %zu key(s) it would have you credit with nothing."
msgstr "Info: %s: %zu clave(s) que le pide no acreditar en nada."

#: ../src/trustdb.c:579
msgid "Info: credibility changes:"
msgstr "Info: cambios de credibilidad:"

#: ../src/trustdb.c:582
#, c-format
msgid "  - %s"
msgstr "  - %s"

#: ../src/trustdb.c:585
#, c-format
msgid "  + %s"
msgstr "  + %s"

#: ../src/trustdb.c:614
msgid "listing the certificates"
msgstr "listando los certificados"

#: ../src/trustdb.c:685
msgid "Error: A fingerprint is required to set a credibility."
msgstr "Error: Hace falta una huella para poner una credibilidad."

#: ../src/trustdb.c:691
msgid "Notice: One of undefined, never, marginal, full, ultimate."
msgstr "Notice: A elegir: undefined, never, marginal, full, ultimate."

#: ../src/trustdb.c:698
msgid "Error: 'unknown' cannot be set; it is what a certificate"
msgstr "Error: «unknown» no se pone; es como se lee un certificado"

#: ../src/trustdb.c:699
msgid "Notice: no one has ruled on already reads as."
msgstr "Notice: sobre el que nadie se ha pronunciado todavía."

#: ../src/trustdb.c:732
msgid "setting the credibility"
msgstr "poniendo la credibilidad"

#: ../src/trustdb.c:790
#, c-format
msgid "Error: '%s' wants a path."
msgstr "Error: «%s» espera una ruta."

#: ../src/trustdb.c:816
msgid "Error: 'export' takes no argument; the path goes to --export-file."
msgstr "Error: «export» no toma argumento; la ruta va a --export-file."

#: ../src/trustdb.c:848
msgid "Error: Nothing to export: no decision worth signing."
msgstr "Error: Nada que exportar: ninguna decisión que valga una firma."

#: ../src/trustdb.c:874
msgid "Error: gpg would not sign the export."
msgstr "Error: gpg no quiso firmar la exportación."

#: ../src/trustdb.c:877
#, c-format
msgid "Notice: %zu delegation(s) signed. Publish it beside the tree it explains, so that anyone can replay it."
msgstr "Notice: %zu delegación(es) firmada(s). Publíquela junto al árbol que explica, para que cualquiera pueda rehacerla."

#: ../src/trustdb.c:895
msgid "Error: Cannot read what this machine already says."
msgstr "Error: No se puede leer lo que esta máquina ya dice."

#: ../src/trustdb.c:906
msgid "Error: No key here is ultimate, so there is no anchor to extend from."
msgstr "Error: Aquí ninguna clave es ultimate, así que no hay ancla que extender."

#: ../src/trustdb.c:908
#, c-format
msgid "Notice: Mark your own certificate ultimate first: %s trustdb local --replace-to ultimate FINGERPRINT"
msgstr "Notice: Marque primero su propio certificado como ultimate: %s trustdb local --replace-to ultimate HUELLA"

#: ../src/trustdb.c:959
msgid "Info: The delegations are already applied — credibility left unchanged."
msgstr "Info: Las delegaciones ya están aplicadas — la credibilidad queda sin cambios."

#: ../src/trustdb.c:980
#, c-format
msgid "Notice: Current credibility backed up in %s."
msgstr "Notice: Credibilidad actual guardada en %s."

#: ../src/trustdb.c:982
#, c-format
msgid "Warning: Cannot write the backup %s — going ahead anyway would leave no way back. Stopping."
msgstr "Warning: No se puede escribir el respaldo %s — seguir de todos modos no dejaría vuelta atrás. Se detiene."

#: ../src/trustdb.c:990
#, c-format
msgid "Error: Delegation chain broken: the signer of %s is not (yet) valid."
msgstr "Error: Cadena de delegaciones rota: el firmante de %s no es (todavía) válido."

#: ../src/trustdb.c:997
#, c-format
msgid "Error: gpg would not import the delegation from %s."
msgstr "Error: gpg se negó a importar la delegación de %s."

#: ../src/trustdb.c:1011
#, c-format
msgid "Notice: To restore the previous credibility: gpg --import-ownertrust %s"
msgstr "Notice: Para restablecer la credibilidad anterior: gpg --import-ownertrust %s"

#: ../src/trustdb.c:1065
msgid "Error: Too many files at once."
msgstr "Error: Demasiados ficheros a la vez."

#: ../src/trustdb.c:1093
msgid "Error: One of local, export or import is required."
msgstr "Error: Hace falta uno de local, export o import."

#: ../src/trustdb.c:1117
#, c-format
msgid "Error: '%s' is not one of local, export or import."
msgstr "Error: «%s» no es local, ni export, ni import."

#: ../src/uidedit.c:69
msgid "Error: Revoking a User ID is irreversible — OpenPGP keeps it"
msgstr "Error: Revocar un User ID es irreversible — OpenPGP lo guarda"

#: ../src/uidedit.c:70
msgid "on the certificate forever, marked revoked, and an identical one"
msgstr "para siempre en el certificado, marcado revocado, y uno idéntico"

#: ../src/uidedit.c:71
msgid "can never be added again. Pass --yes if that is what you want:"
msgstr "no podrá volver a añadirse nunca. Pase --yes si es lo que quiere:"

#: ../src/uidedit.c:72
#, c-format
msgid "  %s"
msgstr "  %s"

#: ../src/uidedit.c:75
#, c-format
msgid "Notice: Revoking %s inside certificate %s…"
msgstr "Notice: Revocando %s en el certificado %s…"

#: ../src/uidedit.c:78
#, c-format
msgid "Error: gpg would not revoke %s."
msgstr "Error: gpg se negó a revocar %s."

#: ../src/uidedit.c:115
#, c-format
msgid "Warning: No address left on certificate %s to carry the primary User ID flag."
msgstr "Warning: No queda dirección en el certificado %s que lleve la marca de User ID principal."

#: ../src/uidedit.c:119
#, c-format
msgid "Notice: Main identity is no longer an address: moving the primary User ID flag to %s."
msgstr "Notice: La identidad principal ya no es una dirección: la marca de User ID principal pasa a %s."

#: ../src/uidedit.c:123
msgid "Error: gpg would not move the primary User ID flag."
msgstr "Error: gpg se negó a mover la marca de User ID principal."

#: ../src/uidedit.c:173
#, c-format
msgid "Notice: Minting the identity uid %s…"
msgstr "Notice: Acuñando el uid de identidad %s…"

#: ../src/uidedit.c:176
#, c-format
msgid "Error: gpg would not add %s."
msgstr "Error: gpg se negó a añadir %s."

#: ../src/uidedit.c:195
#, c-format
msgid "Warning: gpg would not add %s."
msgstr "Warning: gpg se negó a añadir %s."

