#: ../src/trustdb.c:40
#, c-format
msgid ""
"Usage: %s trustdb local|export|import [OPTIONS]... [FINGERPRINT|OWNERTRUSTS.GPG]...\n"
"\n"
"Read and move the credibility you grant others to certify.\n"
"\n"
"  local    What this machine says about the given certificates, or about\n"
"           every one of them when none is named.\n"
"  export   The same, signed, for others to replay. Writes to stdout.\n"
"  import   Apply what others signed, fetching the keys it names. Order\n"
"           is part of what it means: a signer must already be valid when\n"
"           its turn comes, and each file is weighed against what the\n"
"           one before it decided.\n"
"\n"
"OPTIONS:\n"
"  -r, --replace-to VALUE      local: set it instead of printing it — needs\n"
"                              at least one fingerprint\n"
"      --long                  local: also the identifier and main address\n"
"      --check                 local, import: work the web of trust out again\n"
"      --update                the same, asking about the keys nobody has ruled on\n"
"      --export-file FILE      export: write there instead of stdout\n"
"  -u, --use-privkey NAME|KEYID  export: sign with this key\n"
"      --export-all            export: include ultimate and unknown too\n"
"      --armor                 export: ASCII rather than binary, to commit it\n"
"      --import-fetch-all      import: fetch or refresh every key it names,\n"
"                              not only the ones missing here\n"
"  -K, --keyservers SERVERS    import: ask these, space separated — empty\n"
"                              for none\n"
"  -q, --quiet                 Only errors and warnings\n"
"  -h, --help                  Print this help and exit\n"
"  -V, --version               Print the version and exit\n"
msgstr ""
"Usage: %s trustdb local|export|import [OPTIONS]... [ОТПЕЧАТОК|OWNERTRUSTS.GPG]...\n"
"\n"
"Читает кредит доверия к другим и переносит его дальше.\n"
"\n"
"  local    Что эта машина говорит о заданных сертификатах, или о каждом из\n"
"           них, когда не назван ни один.\n"
"  export   То же, подписанное, чтобы другие могли это воспроизвести. В stdout.\n"
"  import   Применить подписанное другими, доставая названные им ключи.\n"
"           Порядок входит в смысл: подписавший должен быть уже действителен,\n"
"           когда придёт его черёд, а каждый файл взвешивается относительно\n"
"           того, что решил предыдущий.\n"
"\n"
"OPTIONS:\n"
"  -r, --replace-to ЗНАЧЕНИЕ   local: назначить вместо вывода — требует\n"
"                              хотя бы одного отпечатка\n"
"      --long                  local: также идентификатор и главный адрес\n"
"      --check                 local, import: пересчитать сеть доверия\n"
"      --update                то же, спрашивая о ключах, о которых никто не решил\n"
"      --export-file ФАЙЛ      export: писать туда, а не в stdout\n"
"  -u, --use-privkey ИМЯ|KEYID  export: подписать этим ключом\n"
"      --export-all            export: взять также ultimate и unknown\n"
"      --armor                 export: ASCII, а не двоичное, чтобы положить в git\n"
"      --import-fetch-all      import: достать или обновить все названные ключи,\n"
"                              не только недостающие здесь\n"
"  -K, --keyservers СЕРВЕРЫ    import: спрашивать эти, через пробел — пусто,\n"
"                              чтобы не спрашивать никого\n"
"  -q, --quiet                 Только ошибки и предупреждения\n"
"  -h, --help                  Вывести эту справку и выйти\n"
"  -V, --version               Вывести версию и выйти\n"

