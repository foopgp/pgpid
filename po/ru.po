#, c-format
msgid "Notice: %zu stub(s) will be forgotten; the certificates stay."
msgstr "Notice: будет забыто заглушек: %zu; сертификаты остаются."

#: ../src/tokendel.c:147
msgid "Error: The key refused the factory reset."
msgstr "Error: ключ отказался от сброса к заводским настройкам."

#: ../src/tokendel.c:154
#, c-format
