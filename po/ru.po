msgid "Error: Only a passport zone is read, and this does not begin with 'P'."
msgstr "Error: Читается только зона паспорта, а эта не начинается с «P»."

#: ../src/genu4.c:205
#, c-format
msgid "%s: The zone is %zu characters, not 88."
msgstr "%s: В зоне %zu знаков, а не 88."

#: ../src/genu4.c:218
#, c-format
msgid "%s: The check digit for %s does not agree."
msgstr "%s: Контрольная цифра для %s не сходится."

