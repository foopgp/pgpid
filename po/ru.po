#, c-format
msgid "Error: '%s' is not a three-letter country code we know."
msgstr "Error: «%s» — не известный нам трёхбуквенный код страны."

#: ../src/genu4.c:301
msgid "Error: Where is the machine readable zone?"
msgstr "Error: Где машиночитаемая зона?"

