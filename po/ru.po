#, c-format
msgid "Error: '%s' wants a number of one or more."
msgstr "Error: «%s» ожидает число не меньше единицы."

#: ../src/get.c:157
msgid "Error: What are you looking for? '*' for everything."
msgstr "Error: Что вы ищете? «*» — всё."

#: ../src/get.c:187 ../src/tovcard.c:409
