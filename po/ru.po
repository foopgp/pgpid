msgstr "Error: «%s» — это заглушка на ключе безопасности, а не локальный секрет."

#: ../src/secretdel.c:122
#, c-format
msgid "Notice: '%s token_del' forgets the key; the secret stays on it."
msgstr "Notice: «%s token_del» забывает ключ; секрет остаётся на нём."

#: ../src/secretdel.c:139
#, c-format
msgid "Notice: %zu secret(s) will be deleted. The certificates stay."
