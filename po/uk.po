msgstr "Warning: Бажану мову задають лише 2 малі літери ASCII; її пропущено."

#: ../src/totoken.c:164
msgid "Error: Which secret key should move onto the card?"
msgstr "Error: Який таємний ключ має перейти на картку?"

#: ../src/totoken.c:209
#, c-format
msgid "Error: Cannot write the certificate to %s."
msgstr "Error: Не вдається записати сертифікат до %s."

#: ../src/totoken.c:238
#, c-format
msgid "Error: No email for OpenPGP key '%s'."
msgstr "Error: Немає адреси для ключа OpenPGP «%s»."

#: ../src/totoken.c:262
#, c-format
msgid "Notice: Detected OpenPGP security token: %s."
msgstr "Notice: Виявлено ключ безпеки OpenPGP: %s."

#: ../src/totoken.c:266
#, c-format
msgid "Error: This wipes card %s and everything on it, then takes the"
msgstr "Error: Це стирає картку %s і все, що на ній, а тоді забирає"

#: ../src/totoken.c:267
#, c-format
msgid "secret parts of %s off this machine. Neither can be undone."
msgstr "таємні частини %s із цієї машини. Ані одне, ані друге не скасовується."

