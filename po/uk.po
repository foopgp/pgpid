msgstr "Error: Для якої сутності цей ключ? Дайте --eid."

#: ../src/genkey.c:225
msgid "Deriving one needs a civil status, which is somebody's to give:"
msgstr "Обчислення потребує громадянського стану, а його повідомляє людина:"

#: ../src/genkey.c:226
#, c-format
msgid "  %s gen_u4 --surname … --given-names … --birth-date … --birth-country …"
msgstr "  %s gen_u4 --surname … --given-names … --birth-date … --birth-country …"

