msgstr "Notice: La clé nomme %u adresses ; la première est retenue."

#: ../src/tokencheck.c:386
#, c-format
msgid "Error: The key names %u identifiers, which cannot both be its."
msgstr ""
"Error: La clé nomme %u identifiants, qui ne peuvent pas être tous les siens."

