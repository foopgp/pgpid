#: ../src/systemdeluser.c:114
#, c-format
msgid ""
"Usage: %s system_deluser [OPTIONS]... USER|EID\n"
"\n"
"Remove a local account, and the group of its own. Administrator rights\n"
"required (sudo).\n"
"\n"
"The home directory is kept unless '--remove-home' says otherwise: an\n"
"account can be opened again from the certificate, what its home held\n"
"cannot, and a secret key that never left it would go with it.\n"
"\n"
"OPTIONS:\n"
"  -r, --remove-home           Remove the home directory and its contents too\n"
"  -h, --help                  Print this help and exit\n"
"  -V, --version               Print the version and exit\n"
msgstr ""
"Usage: %s system_deluser [OPTIONS]... UTILISATEUR|EID\n"
"\n"
"Retirer un compte local, et le groupe qui lui est propre. Droits\n"
"d'administrateur requis (sudo).\n"
"\n"
"Le répertoire personnel est gardé sauf si « --remove-home » dit le contraire :\n"
"un compte se rouvre depuis le certificat, ce que contenait son répertoire non,\n"
"et une clé secrète qui n'en serait jamais sortie partirait avec lui.\n"
"\n"
"OPTIONS:\n"
"  -r, --remove-home           Retirer aussi le répertoire personnel\n"
"  -h, --help                  Afficher cette aide et quitter\n"
"  -V, --version               Afficher la version et quitter\n"

#: ../src/systemdeluser.c:180
msgid "Error: Which account?"
msgstr "Error: Quel compte ?"

#: ../src/systemdeluser.c:185
msgid "Error: Closing an account needs administrator rights (sudo)."
msgstr "Error: Fermer un compte demande les droits d'administrateur (sudo)."

#: ../src/systemdeluser.c:204
#, c-format
msgid "Error: '%s' is the administrator of this machine."
msgstr "Error: « %s » est l'administrateur de cette machine."

#: ../src/systemdeluser.c:210
#, c-format
msgid "Error: '%s' is logged in; an account cannot be closed under its owner."
msgstr "Error: « %s » est connecté ; un compte ne se ferme pas sous son propriétaire."

#: ../src/systemdeluser.c:218
#, c-format
msgid "Error: '%s' could not be removed."
msgstr "Error: « %s » n'a pas pu être supprimé."

#: ../src/systemdeluser.c:219
#, c-format
