#: ../src/push.c:30
#, c-format
msgid ""
"Usage: %s push [OPTIONS]... FINGERPRINT...\n"
"\n"
"Send certificates to the keyservers as they stand, changing nothing.\n"
"Fingerprints only: what is published cannot be recalled.\n"
"\n"
"OPTIONS:\n"
"  -K, --keyservers SERVERS    Send to these, space separated\n"
"                              Empty for none. Default: %s\n"
"  -h, --help                  Print this help and exit\n"
"  -V, --version               Print the version and exit\n"
msgstr ""
"Usage: %s push [OPTIONS]... IMPRONTA...\n"
"\n"
"Inviare certificati ai server di chiavi così come sono, senza cambiare\n"
"nulla. Solo impronte: ciò che è pubblicato non si richiama.\n"
"\n"
"OPTIONS:\n"
"  -K, --keyservers SERVER     Inviare a questi, separati da spazi\n"
"                              Vuoto per nessuno. Default: %s\n"
"  -h, --help                  Stampare questo aiuto e uscire\n"
"  -V, --version               Stampare la versione e uscire\n"

#: ../src/push.c:80
msgid "Error: Which certificate?"
msgstr "Error: Quale certificato?"

