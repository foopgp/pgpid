#: ../src/genuid.c:30
#, c-format
msgid ""
"Usage: %s gen_uid [OPTIONS]... U4|U5|STRING\n"
"\n"
"Print the Unix account number an entity identifier gives, between\n"
"%lld and %lld. The same identifier always gives the same number, on\n"
"any machine — which is what lets an account be opened again\n"
"elsewhere from the certificate alone.\n"
"\n"
"OPTIONS:\n"
"  -f, --free-input            Accept any string, not only an identifier\n"
"  -h, --help                  Print this help and exit\n"
"  -V, --version               Print the version and exit\n"
"\n"
"Asking interactively for a civil status is the caller's business:\n"
"this reads what it is given and nothing else.\n"
msgstr ""
"Usage: %s gen_uid [OPTIONS]... U4|U5|STRINGA\n"
"\n"
"Stampare il numero di conto Unix che dà un identificativo d'entità, tra\n"
"%lld e %lld. Lo stesso identificativo dà sempre lo stesso numero, su\n"
"qualunque macchina — è ciò che permette di riaprire un conto altrove a\n"
"partire dal solo certificato.\n"
"\n"
"OPTIONS:\n"
"  -f, --free-input            Accettare qualsiasi stringa, non solo un id\n"
"  -h, --help                  Stampare questo aiuto e uscire\n"
"  -V, --version               Stampare la versione e uscire\n"
"\n"
"Chiedere uno stato civile in modo interattivo spetta al chiamante: questo\n"
"legge ciò che gli si dà e nient'altro.\n"

#: ../src/genuid.c:157
msgid "Error: Which identifier?"
msgstr "Error: Quale identificativo?"

#: ../src/genuid.c:180
#, c-format
msgid "Error: No entity identifier in '%.50s'."
msgstr "Error: Nessun identificativo d'entità in «%.50s»."

