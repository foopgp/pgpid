#
# The program completes itself: the actions come from its dispatch table and
# the options from each action's own help, so nothing here can fall behind a
# release. Same arrangement as the bl-* libraries.

if pgpid --version > /dev/null 2>&1 ; then
  eval "$(pgpid --bash-completion)"
fi
