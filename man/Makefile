# Two kinds of page. The ones at the top level are English and go where man
# looks by default; the ones under a language directory go under the same
# name in mandir, which is where man looks when LANG says so. They are
# generated by help2man.sh from the tools' own --help, in every language the
# catalogues cover.

SOURCES           := $(wildcard *.md) $(wildcard */*.md)
TARGETS           := $(basename $(SOURCES))

prefix            ?= /usr/local
datarootdir       ?= $(prefix)/share
mandir            ?= $(datarootdir)/man

GZIPPED_TARGETS   := $(addsuffix .gz, $(TARGETS))
MANDIR            := $(DESTDIR)$(mandir)

# man1/foo.1 for an English page, fr/man1/foo.1 for a French one: the section
# directory goes *after* the language, which is the layout man expects and the
# reason this cannot be a single foreach over basenames.
DEST_TARGETS      := $(foreach ITEM, $(TARGETS), \
                       $(MANDIR)/$(dir $(ITEM))man$(subst .,,$(suffix $(ITEM)))/$(notdir $(ITEM)).gz)
DEST_TARGETS_DIRS := $(sort $(dir $(DEST_TARGETS)))

SHELL             := /bin/sh
INSTALL           := install
INSTALL_DATA      := $(INSTALL) --mode 644
TO_MAN            := pandoc --standalone --to=man
GIT_DATE          := LANG=C git log --max-count 1
GIT_DATE          += --format='%ad' --date='format:%d %B %Y' --

.POSIX:
.SUFFIXES:
.DELETE_ON_ERROR:

all: build

build: $(GZIPPED_TARGETS)

check: build

clean:
	$(RM) $(TARGETS) $(GZIPPED_TARGETS)

install: build | $(DEST_TARGETS_DIRS)
	@for item in $(TARGETS) ; do \
		dest="$(MANDIR)/$$(dirname $$item)/man$$(echo $$item | sed 's/.*\.//')" ; \
		dest="$$(echo $$dest | sed 's,/\./,/,')" ; \
		$(INSTALL) --directory "$$dest" && \
		$(INSTALL_DATA) "$$item.gz" "$$dest/$$(basename $$item).gz" || exit 1 ; \
	done

uninstall:
	$(RM) $(DEST_TARGETS)

.PHONY: all build check clean install uninstall

%:: %.md Makefile
	$(TO_MAN) --metadata date:"$$($(GIT_DATE) $<)" < $< > $@

%.gz: %
	gzip < $< > $@

$(DEST_TARGETS_DIRS):
	-mkdir -p $@
